DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spendsense_app
DB_PASSWORD=replace_with_a_local_password
DB_NAME=spendsense
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_AUTH_REQUIRED=false
# Required when APP_AUTH_REQUIRED=true. Generate a value with:
# py -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Generate with: py -m app.auth (run from the backend folder).
APP_PASSWORD_HASH=
